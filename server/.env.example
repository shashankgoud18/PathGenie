# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Or individual PG vars (used if DATABASE_URL is not set):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=pathgenie

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── App URLs ────────────────────────────────────────────────────────────────
PORT=5000
# The public URL of this Express server (used in OAuth callback URLs)
SERVER_URL=http://localhost:5000
# The public URL of the React client (used to redirect after OAuth)
CLIENT_URL=http://localhost:5173

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at https://console.developers.google.com/
# Authorized redirect URI must be: SERVER_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be: SERVER_URL/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── AI ─────────────────────────────────────────────────────────────────────
# Comma-separated list for round-robin key rotation
GEMINI_API_KEYS=key1,key2,key3

# ─── YouTube Data API ────────────────────────────────────────────────────────
# https://console.developers.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Upstash Redis ───────────────────────────────────────────────────────────
REDIS_URL=https://your-redis-url.upstash.io
REDIS_TOKEN=your_upstash_redis_token

# ─── Contact Form Email (Nodemailer) ─────────────────────────────────────────
# Any SMTP provider: Gmail, Brevo, Mailgun, Resend SMTP, etc.
# For Gmail: enable "App Passwords" in your Google account security settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
# Where contact form submissions are forwarded to (defaults to SMTP_USER)
CONTACT_TO_EMAIL=hello@pathgenie.tech
